# Dashboard → API keys → sk_live_…
QRDOT_API_KEY=sk_live_replace_me

# Stable id for this event (used in metadata + idempotency keys)
EVENT_ID=summit-2026

# Seat for single-ticket scripts (issue / image / doors-open)
SEAT=A12

# Pre-event landing (printed on the ticket). Change later with doors-open.
PRE_EVENT_URL=https://example.com/event/summit-2026/preview

# Doors-open / live landing after PATCH
DOORS_URL=https://example.com/event/summit-2026/doors

# Optional: ISO expire time (default: 7 days from issue)
# EXPIRE_AT=2026-12-31T23:59:59.000Z

# Optional: scan cap (default: 2 — one test scan + one real entry)
# MAX_SCANS=2

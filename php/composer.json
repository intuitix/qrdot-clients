{
  "name": "intuitix/qrdot-php",
  "description": "Official PHP client for the QR. API (qrdot.dev)",
  "type": "library",
  "license": "MIT",
  "keywords": ["qr", "qrcode", "qrdot", "api"],
  "homepage": "https://qrdot.dev/libraries/",
  "support": {
    "docs": "https://qrdot.dev/docs/",
    "issues": "https://github.com/intuitix/qrdot-clients/issues",
    "source": "https://github.com/intuitix/qrdot-clients/tree/main/php"
  },
  "authors": [
    {
      "name": "QR.",
      "email": "hello@qrdot.dev",
      "homepage": "https://qrdot.dev"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "classmap": ["src/Client.php"],
    "files": ["src/functions.php"]
  },
  "autoload-dev": {
    "psr-4": {
      "Qrdot\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "minimum-stability": "stable"
}

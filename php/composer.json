{
  "name": "intuitix/qrdot-php",
  "description": "Official PHP client for the QR. API (qrdot.dev)",
  "type": "library",
  "license": "MIT",
  "version": "0.1.1",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "classmap": ["src/Client.php"],
    "files": ["src/functions.php"]
  },
  "autoload-dev": {
    "psr-4": {
      "Qrdot\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
